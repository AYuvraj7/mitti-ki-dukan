rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /vendors/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null &&
        (request.auth.uid == uid || request.auth.token.email == "thrivesocietyofficial@gmail.com");
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.status == "approved";
      allow update, delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid
            || request.auth.token.email == "thrivesocietyofficial@gmail.com");
    }
  }
}
